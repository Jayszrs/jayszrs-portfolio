# App URL
NEXT_PUBLIC_SITE_URL=https://www.jayszrs.my.id

# Admin login
ADMIN_PASSWORD=ganti_password_admin_lu

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_xxx

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# CMS uploads: supabase uses the existing project and a pre-created public bucket.
# Run node scripts/prepare-cms-storage.cjs once with server credentials before enabling.
CMS_UPLOAD_STORAGE=supabase
CMS_UPLOAD_BUCKET=portfolio-media

# Google Search Console
GOOGLE_SITE_VERIFICATION=google_site_verification_code

# Optional TikTok Display API token. Keep server-only; never prefix with NEXT_PUBLIC_.
# Requires user.info.profile and video.list; identity is verified before displaying videos.
TIKTOK_ACCESS_TOKEN=
